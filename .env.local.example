# Supabase — from your project's API settings
# Dashboard: https://supabase.com/dashboard/project/urhijvyvfilkzbcfnazj/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://urhijvyvfilkzbcfnazj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key — SERVER ONLY, never expose to the browser.
# Used by server actions / API routes that need to bypass RLS (e.g. the send worker).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed app (used to build confirm/unsubscribe links).
# In Vercel this is set automatically per-deployment; for local dev use http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secures the /api/send cron endpoint (any random string). Vercel cron sends it
# automatically as `Authorization: Bearer <CRON_SECRET>` when this is set.
CRON_SECRET=

# ===================== Email delivery (LISTSERV_* namespace) =====================
# Required for every provider. Must be a verified sender (Brevo) or on a
# verified domain (Resend).
LISTSERV_EMAIL_FROM="My List <list@yourdomain.com>"

# Which provider to use: "resend" (default) or "smtp".
LISTSERV_EMAIL_PROVIDER=smtp

# --- Resend (LISTSERV_EMAIL_PROVIDER=resend) ---
# Create a key at https://resend.com/api-keys and verify your sending domain.
LISTSERV_RESEND_API_KEY=

# --- Generic SMTP (LISTSERV_EMAIL_PROVIDER=smtp) — Brevo, Amazon SES, Mailgun ---
# Brevo:  LISTSERV_SMTP_HOST=smtp-relay.brevo.com  LISTSERV_SMTP_PORT=587
#         LISTSERV_SMTP_USER=<Brevo SMTP login>    LISTSERV_SMTP_PASS=<Brevo SMTP key>
LISTSERV_SMTP_HOST=smtp-relay.brevo.com
LISTSERV_SMTP_PORT=587
LISTSERV_SMTP_SECURE=false
LISTSERV_SMTP_USER=
LISTSERV_SMTP_PASS=
